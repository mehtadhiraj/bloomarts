{% if section.settings.enabled %}
  {% assign whatsapp_number = section.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' %}
  {% assign instagram_url = settings.social_instagram %}
  {% if whatsapp_number != blank or instagram_url != blank %}
    {{ 'floating-social.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'floating-social.js' | asset_url }}" defer></script>
    <floating-social class="floating-social" role="navigation" aria-label="Connect with Bloom Arts">
      <button class="floating-social__toggle" type="button" aria-expanded="true" aria-controls="SocialLinks-{{ section.id }}" aria-label="Hide social links"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
      <div class="floating-social__links" id="SocialLinks-{{ section.id }}">
      {% if whatsapp_number != blank %}
        <a data-social-whatsapp data-phone="{{ whatsapp_number | escape }}" href="https://wa.me/{{ whatsapp_number | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Chat with Bloom Arts on WhatsApp" title="Chat on WhatsApp">
          <img src="{{ 'whatsapp-logo.svg' | asset_url }}" width="38" height="38" alt="">
        </a>
      {% endif %}
      {% if instagram_url != blank %}
        <a data-social-instagram href="{{ instagram_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Bloom Arts on Instagram" title="Visit Instagram">
          {% render 'icon', icon: 'instagram', size: 25 %}
        </a>
      {% endif %}
      </div>
    </floating-social>
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "Floating social links",
  "settings": [
    {"type":"checkbox","id":"enabled","label":"Show floating social links","default":true},
    {"type":"text","id":"whatsapp","label":"WhatsApp number with country code","default":"918356913551"},
    {"type":"paragraph","content":"Instagram uses the Instagram URL in Theme settings → Social media. Links appear across the storefront, not Shopify checkout."}
  ]
}
{% endschema %}
