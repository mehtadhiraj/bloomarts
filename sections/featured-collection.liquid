{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-swatches.css' | asset_url | stylesheet_tag }}
{{ 'component-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured = collections[section.settings.collection]
  assign limit = section.settings.products_to_show | default: 8
-%}

<section class="section defer-render featured">
  {% render 'ghost-word', word: section.settings.ghost_word %}
  <div class="page-width">
    <div class="section-head" data-scroll-reveal="blur">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if featured != blank -%}
        <a href="{{ featured.url }}" class="section-head__link">
          {{ 'collections.general.view_all' | t }}
          {% render 'icon', icon: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if featured.products.size > 0 -%}
    {%- comment -%}
      A swipe carousel on mobile, a grid from 1024px.

      On a phone this is the right shape: it shows the row is scrollable
      without spending four screens of vertical space, and it uses the same
      CSS scroll-snap the product gallery does — native momentum, no
      JavaScript for the gesture. The peeking next card is the affordance
      that says "there is more this way".
    {%- endcomment -%}
    <div
      class="carousel"
      role="group"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.heading }}"
      tabindex="0"
    >
      <ul class="carousel__track" role="list" data-reveal-group>
        {%- for product in featured.products limit: limit -%}
          <li class="carousel__item" data-reveal="rise-stagger">
            {%- liquid
              if forloop.index <= 2
                assign card_loading = 'eager'
              else
                assign card_loading = 'lazy'
              endif
            -%}
            {% render 'product-card',
               product: product,
               loading: card_loading,
               sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 40vw, 62vw' %}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fresh from the studio" },
    {
      "type": "text",
      "id": "ghost_word",
      "label": "Background word",
      "info": "An oversized, very faint word behind the section. Decorative \u2014 repeat a word from the heading. Leave blank to hide.",
      "default": "Handmade"
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New this month" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
