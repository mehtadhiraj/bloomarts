{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-swatches.css' | asset_url | stylesheet_tag }}
{{ 'component-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carousel.js' | asset_url }}" defer></script>

{%- liquid
  assign featured = collections[section.settings.collection]
  assign product_limit = section.settings.products_to_show | default: 8
-%}

<section class="section defer-render featured">
  <div class="page-width">
    <div class="section-head" data-scroll-reveal="blur">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      </div>
      {%- comment -%}
        The chosen collection is the sensible default, but the link is
        overridable — a merchant showing one collection here may well want the
        "view all" to lead somewhere broader.
      {%- endcomment -%}
      {%- liquid
        assign head_link = section.settings.link
        if head_link == blank
          assign head_link = featured.url
        endif
      -%}
      {%- if head_link != blank -%}
        <a href="{{ head_link }}" class="section-head__link">
          {%- if section.settings.link_label != blank -%}
            {{ section.settings.link_label }}
          {%- else -%}
            {{ 'collections.general.view_all' | t }}
          {%- endif -%}
          {% render 'icon', icon: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if featured.products.size > 0 -%}
    {%- comment -%}
      One scrolling row at every size.

      It previously became a 4-up grid from 1024px, which wrapped onto a
      second and third row as soon as the section held more than four
      products — the opposite of a carousel. Now the row stays a row, and
      arrows appear on pointer devices where there is no swipe gesture.

      The scroll uses the same CSS scroll-snap as the product gallery:
      native momentum on touch, and it works before the script loads. The
      peeking next card is the affordance that says "there is more this way".
    {%- endcomment -%}
    <bloom-carousel class="carousel-wrap">
      <button
        type="button"
        class="carousel__arrow carousel__arrow--prev tap-target"
        data-carousel-prev
      >
        {% render 'icon', icon: 'chevron-left' %}
        <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
      </button>

      {%- comment -%}
        tabindex makes the scroll container focusable so a keyboard user can
        arrow through the row — a plain overflow container cannot be reached
        otherwise.
      {%- endcomment -%}
      <div
        class="carousel"
        data-carousel-track
        role="group"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.heading }}"
        tabindex="0"
      >
        <ul class="carousel__track" role="list" data-reveal-group>
        {%- for product in featured.products limit: product_limit -%}
          <li class="carousel__item" data-carousel-item data-reveal="rise-stagger">
            {%- liquid
              if forloop.index <= 2
                assign card_loading = 'eager'
              else
                assign card_loading = 'lazy'
              endif
            -%}
            {% render 'product-card',
               product: product,
               loading: card_loading,
               sizes: '(min-width: 1024px) 25vw, (min-width: 768px) 40vw, 62vw' %}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <button
        type="button"
        class="carousel__arrow carousel__arrow--next tap-target"
        data-carousel-next
      >
        {% render 'icon', icon: 'chevron-right' %}
        <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
      </button>
    </bloom-carousel>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "A short label above the heading.",
      "default": "Home décor & gifting"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gifts for every happy moment"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Where the link beside the heading goes. Defaults to the collection above."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
