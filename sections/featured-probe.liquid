{%- comment -%}
  Diagnostic probe. Same schema as featured-collection, trivial body.
  If this renders and featured-collection does not, the fault is in the
  body. If neither renders, the fault is in the schema.
{%- endcomment -%}

<section class="featured-probe">
  <p>featured probe rendered</p>
  <span data-probe="eyebrow">{{ section.settings.eyebrow }}</span>
  <span data-probe="ghost_word">{{ section.settings.ghost_word }}</span>
  <span data-probe="heading">{{ section.settings.heading }}</span>
  <span data-probe="collection">{{ section.settings.collection }}</span>
  <span data-probe="products_to_show">{{ section.settings.products_to_show }}</span>
</section>

{% schema %}
{
  "name": "Featured probe",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fresh from the studio"
    },
    {
      "type": "text",
      "id": "ghost_word",
      "label": "Background word",
      "info": "An oversized, very faint word behind the section. Decorative only \u2014 repeat a word from the heading. Leave blank to hide.",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New this month"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ]
}
{% endschema %}
