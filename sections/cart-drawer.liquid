{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-quantity.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quantity-input.js' | asset_url }}" defer></script>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

{%- comment -%}
  This is a section rather than a snippet so the Cart API can re-render it
  directly (`sections=cart-drawer`) after every change. Rebuilding the markup
  in JavaScript would mean maintaining a second copy of the line-item
  template that drifts from the Liquid one.
{%- endcomment -%}

<cart-drawer
  id="cart-drawer"
  class="drawer drawer--side cart-drawer"
  data-cart-drawer
>
  <div class="drawer__overlay" data-drawer-overlay></div>

  <div
    class="drawer__panel"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="cart-drawer-title"
    tabindex="-1"
  >
    <div class="drawer__handle" data-drawer-handle aria-hidden="true"></div>

    <div class="drawer__header">
      <h2 class="drawer__title" id="cart-drawer-title">
        {{ 'cart.general.title' | t }}
        <span class="cart-drawer__count text-sm text-muted" data-cart-count-label>
          ({{ 'cart.general.item_count' | t: count: cart.item_count }})
        </span>
      </h2>
      <button class="drawer__close tap-target" type="button" data-drawer-close data-drawer-initial-focus>
        {% render 'icon', icon: 'close' %}
        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
      </button>
    </div>

    {%- comment -%}
      Everything inside this wrapper is replaced wholesale on update. The
      drawer element itself is never swapped, so open state, focus and the
      scroll lock survive a re-render.
    {%- endcomment -%}
    <div class="cart-drawer__contents" data-cart-contents>
      {%- if cart.item_count > 0 -%}
        <div class="drawer__body">
          <ul class="cart-items" role="list" data-cart-items>
            {%- for item in cart.items -%}
              {% render 'cart-line-item', item: item, compact: true %}
            {%- endfor -%}
          </ul>
        </div>

        <div class="drawer__footer cart-drawer__footer">
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart-discounts" role="list">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="text-sm">{{ discount.title }} (&minus;{{ discount.total_allocated_amount | money }})</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="cart-summary">
            <span class="cart-summary__label">{{ 'cart.general.subtotal' | t }}</span>
            <span class="cart-summary__value" data-cart-subtotal>{{ cart.total_price | money }}</span>
          </div>

          <p class="text-xs text-muted cart-drawer__note">{{ 'cart.general.taxes_note' | t }}</p>

          {%- comment -%}
            A real POST to /cart with name="checkout" — the same handoff
            Shopify expects. No JavaScript is involved in reaching checkout,
            so a script failure can never trap a customer at the cart.
          {%- endcomment -%}
          <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
            <button type="submit" name="checkout" class="btn btn--primary btn--full cart-drawer__checkout">
              {{ 'cart.general.checkout' | t }}
            </button>
          </form>

          <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart">
            {{ 'cart.general.view_cart' | t }}
          </a>
        </div>
      {%- else -%}
        <div class="drawer__body cart-drawer__empty">
          <p>{{ 'cart.general.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" data-drawer-close>
            {{ 'cart.general.empty_action' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
