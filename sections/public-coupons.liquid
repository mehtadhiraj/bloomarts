{%- capture cards -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.enabled -%}
    {%- if block.settings.kind == 'automatic' and block.settings.description != blank -%}
      <div class="coupon-card" data-offer data-start="{{ block.settings.starts | escape }}" data-end="{{ block.settings.ends | escape }}" data-minimum="{{ block.settings.minimum }}" data-currency="{{ block.settings.currency | escape }}" data-shipping="{{ block.settings.shipping }}" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.description | escape }}</strong>
        {% render 'coupon-conditions', offer: block.settings %}
        <small>{{ section.settings.automatic_label | escape }}</small>
        <span data-shipping-progress hidden></span>
      </div>
    {%- elsif block.settings.code != blank -%}
      <button type="button" class="coupon-card" data-coupon="{{ block.settings.code | strip | escape }}" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.code | strip | escape }}</strong>
        <span>{{ block.settings.description | escape }}</span>
        {% render 'coupon-conditions', offer: block.settings %}
        <small>{{ section.settings.copy_label | escape }}</small>
      </button>
    {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign cards = cards | strip -%}
{%- if section.settings.enabled and cards != blank -%}
  {{ 'public-coupons.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'public-coupons.js' | asset_url }}" defer></script>
  <public-coupons data-success="{{ section.settings.success | escape }}" data-failure="{{ section.settings.failure | escape }}" data-remaining="{{ section.settings.remaining | escape }}" data-unlocked="{{ section.settings.unlocked | escape }}">
    <div class="coupon-bar" role="region" aria-label="{{ section.settings.heading | escape }}">
      <button type="button" class="coupon-pause" data-pause data-play="{{ section.settings.play | escape }}" data-stop="{{ section.settings.pause | escape }}" hidden>{{ section.settings.pause | escape }}</button>
      <div class="coupon-window"><div class="coupon-track">{{ cards }}</div></div>
    </div>
    <button class="coupon-launcher" type="button" data-open aria-controls="CouponPanel-{{ section.id }}" aria-haspopup="dialog" hidden>٪ {{ section.settings.heading | escape }}</button>
    <dialog id="CouponPanel-{{ section.id }}" class="coupon-dialog" aria-labelledby="CouponTitle-{{ section.id }}">
      <div class="coupon-dialog__header"><h2 id="CouponTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><button type="button" data-close aria-label="{{ section.settings.close | escape }}">×</button></div>
      <div class="coupon-list">{{ cards }}</div>
    </dialog>
    <p class="coupon-toast" role="status" aria-live="polite" aria-atomic="true"></p>
  </public-coupons>
{%- elsif request.design_mode -%}
  <p class="page-width">Public coupons: add enabled blocks for existing Shopify discount codes or automatic offers. Only publish offers intended for everyone.</p>
{%- endif -%}
{% schema %}
{
  "name": "Public coupons", "max_blocks": 12,
  "settings": [
    {"type":"checkbox","id":"enabled","label":"Show public coupons","default":true},
    {"type":"paragraph","content":"Add existing Shopify codes or automatic offers intended for public sharing. This list does not sync with Discounts. Match amounts and dates to Shopify; disable expired codes here. Shopify validates final eligibility at checkout."},
    {"type":"text","id":"heading","label":"Heading / mobile button","default":"Coupons"},
    {"type":"text","id":"copy_label","label":"Copy hint","default":"Tap to copy"},
    {"type":"text","id":"automatic_label","label":"Automatic offer hint","default":"Automatically applied at checkout"},
    {"type":"text","id":"remaining","label":"Shipping progress message","default":"Add [amount] more to unlock free shipping.","info":"Keep [amount] where the remaining spend should appear."},
    {"type":"text","id":"unlocked","label":"Shipping unlocked message","default":"You have unlocked free shipping! 🎉"},
    {"type":"text","id":"success","label":"Copy confirmation","default":"Coupon code copied! 🥳"},
    {"type":"text","id":"failure","label":"Copy failure message","default":"Could not copy automatically. Please select and copy the code manually."},
    {"type":"text","id":"pause","label":"Pause label","default":"Pause offers"},
    {"type":"text","id":"play","label":"Play label","default":"Play offers"},
    {"type":"text","id":"close","label":"Close label","default":"Close coupons"}
  ],
  "blocks":[{"type":"coupon","name":"Public coupon","settings":[
    {"type":"checkbox","id":"enabled","label":"Publish this coupon","default":true},
    {"type":"select","id":"kind","label":"Offer method","default":"code","options":[{"value":"code","label":"Discount code"},{"value":"automatic","label":"Automatic — no code"}]},
    {"type":"checkbox","id":"shipping","label":"Show free-shipping cart progress","default":false,"info":"Automatic offers only. Enable only for an offer whose eligibility is based on this whole-cart minimum. Match Shopify's rules and disclose other restrictions in the description."},
    {"type":"number","id":"minimum","label":"Minimum spend (currency units)","info":"Optional; enter 999 for ₹999, not 99900."},
    {"type":"text","id":"currency","label":"Minimum-spend currency","default":"INR","info":"Three-letter currency. Progress is hidden for carts in a different currency."},
    {"type":"text","id":"starts","label":"Starts at (optional)","info":"ISO timestamp with timezone, e.g. 2026-10-01T00:00:00+05:30."},
    {"type":"text","id":"ends","label":"Ends at (optional)","info":"ISO timestamp with timezone, e.g. 2026-10-15T23:59:59+05:30. Match Shopify's discount dates."},
    {"type":"text","id":"code","label":"Existing discount code"},
    {"type":"text","id":"description","label":"Offer and conditions"}
  ]}]
}
{% endschema %}
