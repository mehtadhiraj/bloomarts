{%- capture cards -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.enabled and block.settings.code != blank -%}
      <button type="button" class="coupon-card" data-coupon="{{ block.settings.code | strip | escape }}" {{ block.shopify_attributes }}>
        <strong>{{ block.settings.code | strip | escape }}</strong>
        <span>{{ block.settings.description | escape }}</span>
        <small>{{ section.settings.copy_label | escape }}</small>
      </button>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign cards = cards | strip -%}
{%- if section.settings.enabled and cards != blank -%}
  {{ 'public-coupons.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'public-coupons.js' | asset_url }}" defer></script>
  <public-coupons data-success="{{ section.settings.success | escape }}" data-failure="{{ section.settings.failure | escape }}">
    <div class="coupon-bar" role="region" aria-label="{{ section.settings.heading | escape }}">
      <button type="button" class="coupon-pause" data-pause data-play="{{ section.settings.play | escape }}" data-stop="{{ section.settings.pause | escape }}" hidden>{{ section.settings.pause | escape }}</button>
      <div class="coupon-window"><div class="coupon-track">{{ cards }}</div></div>
    </div>
    <button class="coupon-launcher" type="button" data-open aria-controls="CouponPanel-{{ section.id }}" aria-haspopup="dialog" hidden>٪ {{ section.settings.heading | escape }}</button>
    <dialog id="CouponPanel-{{ section.id }}" class="coupon-dialog" aria-labelledby="CouponTitle-{{ section.id }}">
      <div class="coupon-dialog__header"><h2 id="CouponTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><button type="button" data-close aria-label="{{ section.settings.close | escape }}">×</button></div>
      <div class="coupon-list">{{ cards }}</div>
    </dialog>
    <p class="coupon-toast" role="status" aria-live="polite" aria-atomic="true"></p>
  </public-coupons>
{%- elsif request.design_mode -%}
  <p class="page-width">Public coupons: add enabled coupon blocks with existing Shopify discount codes. Only publish codes intended for everyone.</p>
{%- endif -%}
{% schema %}
{
  "name": "Public coupons", "max_blocks": 12,
  "settings": [
    {"type":"checkbox","id":"enabled","label":"Show public coupons","default":true},
    {"type":"paragraph","content":"Add existing Shopify discount codes intended for public sharing. This list does not sync with Discounts. Disable expired codes here; Shopify validates eligibility at checkout."},
    {"type":"text","id":"heading","label":"Heading / mobile button","default":"Coupons"},
    {"type":"text","id":"copy_label","label":"Copy hint","default":"Tap to copy"},
    {"type":"text","id":"success","label":"Copy confirmation","default":"Coupon code copied! 🥳"},
    {"type":"text","id":"failure","label":"Copy failure message","default":"Could not copy automatically. Please select and copy the code manually."},
    {"type":"text","id":"pause","label":"Pause label","default":"Pause offers"},
    {"type":"text","id":"play","label":"Play label","default":"Play offers"},
    {"type":"text","id":"close","label":"Close label","default":"Close coupons"}
  ],
  "blocks":[{"type":"coupon","name":"Public coupon","settings":[
    {"type":"checkbox","id":"enabled","label":"Publish this coupon","default":true},
    {"type":"text","id":"code","label":"Existing discount code"},
    {"type":"text","id":"description","label":"Offer and conditions"}
  ]}]
}
{% endschema %}
