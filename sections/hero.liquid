{{ 'component-hero.css' | asset_url | stylesheet_tag }}

<section class="hero hero--{{ section.settings.height }}" data-header-overlay style="--hero-overlay: {{ section.settings.overlay_opacity }};">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="page-width hero__shell">
    <div class="hero__content" data-reveal-group>
      {%- if section.settings.subheading != blank -%}
        <p class="eyebrow hero__subheading" data-reveal="rise-stagger">
          <span class="hero__eyebrow-mark" aria-hidden="true"></span>{{ section.settings.subheading }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading" data-reveal="rise-stagger">
          <span class="hero__heading-line">{{ section.settings.heading }}</span>
          {%- if section.settings.script_accent != blank -%}<span class="script hero__script">{{ section.settings.script_accent }}</span>{%- endif -%}
        </h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}<p class="hero__text" data-reveal="rise-stagger">{{ section.settings.text }}</p>{%- endif -%}

      <div class="hero__actions" data-reveal="rise-stagger">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--primary hero__button">
            {{ section.settings.button_label }}{% render 'icon', icon: 'arrow-right', size: 17 %}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}<a href="{{ section.settings.button_2_link }}" class="hero__text-link">{{ section.settings.button_2_label }}</a>{%- endif -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="hero__note" data-reveal="rise-stagger">{% render 'icon', icon: 'heart', size: 15 %}{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    <div class="hero__visual" data-reveal="scale">
      <div class="hero__media parallax-media">
        {%- if section.settings.image_desktop != blank -%}
          {% render 'art-directed-image', image_desktop: section.settings.image_desktop, image_mobile: section.settings.image_mobile, ratio_mobile: 0.82, ratio_desktop: 0.78, breakpoint: '768px', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt, class: 'hero__image' %}
        {%- else -%}
          <div class="hero__image hero__image--placeholder" aria-hidden="true"></div>
        {%- endif -%}
      </div>
      {%- if section.settings.badge_text != blank -%}
        <div class="hero__badge" aria-label="{{ section.settings.badge_text }}"><span class="hero__badge-spark" aria-hidden="true">✦</span><span>{{ section.settings.badge_text }}</span></div>
      {%- endif -%}
      <p class="hero__caption" aria-hidden="true"><span>Designed with joy</span><span>Chosen with care</span></p>
    </div>
  </div>

  <div class="hero__rail" aria-label="What makes Bloom Arts special">
    <div class="page-width hero__rail-inner"><span>Studio-made</span><span aria-hidden="true">✦</span><span>Joyfully curated</span></div>
  </div>

  {%- if section.settings.show_motifs -%}
    <div class="hero__motifs hide-mobile" aria-hidden="true">
      {% render 'brand-motif', motif: 'sprig', size: 92, class: 'motif--float', style: 'top: 16%; left: -1%;' %}
      {% render 'brand-motif', motif: 'bee', size: 58, class: 'motif--float-slow', style: 'top: 15%; right: 2%;' %}
      {% render 'brand-motif', motif: 'heart', size: 24, class: 'motif--float', style: 'bottom: 18%; left: 46%;' %}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image", "info": "A portrait or square studio image works best in the editorial frame." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional portrait crop for smaller screens." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Concrete · Clay · Resin" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little creations," },
    { "type": "text", "id": "script_accent", "label": "Script accent", "default": "big smiles" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Playful objects and thoughtful gifts—from our own studio-made pieces to cheerful finds chosen for the joy they bring." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary link label", "default": "Our story" },
    { "type": "url", "id": "button_2_link", "label": "Secondary link" },
    { "type": "text", "id": "note", "label": "Collection note", "default": "Made or chosen with care" },
    { "type": "text", "id": "badge_text", "label": "Image badge", "default": "A little joy, picked for you" },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 10 },
    { "type": "checkbox", "id": "show_motifs", "label": "Show decorative motifs", "default": true },
    { "type": "select", "id": "height", "label": "Height", "options": [
      { "value": "compact", "label": "Compact" }, { "value": "standard", "label": "Standard" }, { "value": "tall", "label": "Tall" }, { "value": "full", "label": "Full screen" }
    ], "default": "full" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
