{%- capture occasion_slides -%}
  {% render 'occasion-slide', slide_settings: section.settings, slide_id: section.id %}
  {%- for block in section.blocks -%}
    {%- assign slide_id = section.id | append: '-' | append: block.id -%}
    {% render 'occasion-slide', slide_settings: block.settings, slide_id: slide_id, editor_attributes: block.shopify_attributes %}
  {%- endfor -%}
{%- endcapture -%}
{%- assign occasion_slides = occasion_slides | strip -%}
{%- if section.settings.enabled and occasion_slides != blank -%}
  {{ 'component-occasion.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'occasion-carousel.js' | asset_url }}" defer></script>
  <occasion-carousel class="occasion page-width" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.carousel_label | escape }}" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval }}" data-editor="{{ request.design_mode }}">
    <div class="occasion__controls" data-occasion-controls hidden>
      <button type="button" class="occasion__control" data-occasion-toggle aria-label="{{ 'general.accessibility.pause_slideshow' | t | escape }}" data-pause="{{ 'general.accessibility.pause_slideshow' | t | escape }}" data-play="{{ 'general.accessibility.play_slideshow' | t | escape }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path class="occasion__pause-icon" d="M6 4h4v16H6zm8 0h4v16h-4z"/><path class="occasion__play-icon" d="M7 3v18l15-9z"/></svg>
      </button>
      <button type="button" class="occasion__control" data-occasion-prev aria-label="{{ 'general.accessibility.previous' | t }}">{% render 'icon', icon: 'chevron-left', size: 20 %}</button>
      <span data-occasion-count aria-live="off"></span>
      <button type="button" class="occasion__control" data-occasion-next aria-label="{{ 'general.accessibility.next' | t }}">{% render 'icon', icon: 'chevron-right', size: 20 %}</button>
    </div>
    <div class="occasion__track" data-occasion-track>{{ occasion_slides }}</div>
  </occasion-carousel>
{%- endif -%}

{% schema %}
