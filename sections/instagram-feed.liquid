{{ 'component-instagram.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Instagram / social grid.

  The tiles are fixed-ratio boxes that exist before any content arrives.
  That is the whole point of this section: an Instagram embed or app block
  that injects its own markup is the classic cause of a late layout shift on
  a phone, because it lands after paint and pushes the footer down. Reserving
  the grid up front means whatever fills it — merchant images now, an app
  embed later — drops into space that was already accounted for.
{%- endcomment -%}

{%- liquid
  # An empty grid is six grey squares to a shopper. Reserving space matters
  # once there is something to reserve it for, so the section only renders on
  # the storefront when at least one tile has content. In the theme editor it
  # always renders, otherwise the merchant could never add the first image.
  assign has_media = false
  assign has_embed = false
  for block in section.blocks
    if block.type == '@app'
      assign has_media = true
    endif
    if block.settings.image != blank or block.settings.video != blank
      assign has_media = true
    endif
    if block.settings.permalink != blank
      assign has_media = true
      assign has_embed = true
    endif
  endfor

  # A reel embed is portrait and carries Instagram's own header and caption,
  # so it cannot live in the same small square as a photo. One grid or the
  # other, decided by what is actually in the blocks.
  assign grid_class = 'instagram__grid'
  if has_embed
    assign grid_class = 'instagram__grid instagram__grid--embed'
  endif
-%}

{%- if has_media or request.design_mode -%}
<section class="section defer-render instagram">
  <div class="page-width">
    <div class="section-head" data-scroll-reveal="blur">
      <div class="section-head__text">
        <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if settings.social_instagram != blank -%}
        <a href="{{ settings.social_instagram }}" class="section-head__link" rel="noopener" target="_blank">
          {% render 'icon', icon: 'instagram', size: 18 %}
          <span>@{{ settings.social_instagram_handle }}</span>
        </a>
      {%- endif -%}
    </div>

    <ul
      class="{{ grid_class }}"
      role="list"
      data-shape="{{ section.settings.reel_shape }}"
      data-instagram-grid
      data-reveal-group
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'post' -%}
            {%- liquid
              assign reel = block.settings.video
              assign poster = block.settings.image
              if poster == blank and reel != blank
                assign poster = reel.preview_image
              endif

              # Instagram's own embed markup is a skeleton blockquote plus
              # embed.js, which rewrites it into this same iframe. Only the
              # permalink actually varies, so that is all the merchant pastes:
              # a whole blockquote in a text setting would be unmaintainable
              # and would put a third-party script on every page.
              assign embed_path = ''
              assign raw_link = block.settings.permalink | strip
              if raw_link contains '/reel/'
                assign embed_code = raw_link | split: '/reel/' | last | split: '?' | first | split: '/' | first
                assign embed_path = 'reel'
              elsif raw_link contains '/reels/'
                assign embed_code = raw_link | split: '/reels/' | last | split: '?' | first | split: '/' | first
                assign embed_path = 'reel'
              elsif raw_link contains '/tv/'
                assign embed_code = raw_link | split: '/tv/' | last | split: '?' | first | split: '/' | first
                assign embed_path = 'tv'
              elsif raw_link contains '/p/'
                assign embed_code = raw_link | split: '/p/' | last | split: '?' | first | split: '/' | first
                assign embed_path = 'p'
              endif
              if embed_code == blank
                assign embed_path = ''
              endif

              assign tile_class = 'instagram__tile'
              if embed_path != blank
                assign tile_class = 'instagram__tile instagram__tile--embed'
              elsif reel != blank
                assign tile_class = 'instagram__tile instagram__tile--reel'
              endif
            -%}
            <li class="{{ tile_class }}" data-reveal="scale" {{ block.shopify_attributes }}>
              {%- if embed_path != blank -%}
                {%- comment -%}
                  Lazy, so six of these do not all fetch on first paint, and
                  scrolling="no" because the iframe sizes itself to its own
                  content. Nothing is cropped: the caption and the @bloom.artss
                  attribution are part of what an embed is allowed to be.
                {%- endcomment -%}
                <iframe
                  class="instagram__embed"
                  src="https://www.instagram.com/{{ embed_path }}/{{ embed_code | url_encode }}/embed/"
                  title="{{ 'sections.instagram.embed_title' | t: handle: settings.social_instagram_handle }}"
                  loading="lazy"
                  scrolling="no"
                  frameborder="0"
                  allow="encrypted-media; picture-in-picture; web-share"
                  allowtransparency="true"
                  allowfullscreen
                ></iframe>
              {%- else -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="instagram__link" rel="noopener" target="_blank">
              {%- endif -%}

              {%- if reel != blank -%}
                {%- comment -%}
                  A reel is a Shopify-hosted video, not an embed. Muted, looping
                  and inline so iOS plays it in place rather than going
                  fullscreen. The poster is rendered as a real image so the tile
                  shows something before the first frame decodes, and stays the
                  whole story when motion is turned down.
                {%- endcomment -%}
                <video
                  class="instagram__video"
                  data-reel
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster="{{ poster | image_url: width: 600, height: 600, crop: 'center' }}"
                  width="600"
                  height="600"
                  aria-label="{{ block.settings.alt | escape }}"
                >
                  {%- for source in reel.sources -%}
                    {%- if source.format == 'mp4' -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endif -%}
                  {%- endfor -%}
                </video>
                <span class="instagram__reel-badge" aria-hidden="true">
                  {% render 'icon', icon: 'play', size: 14 %}
                </span>
              {%- else -%}
                {% render 'responsive-image',
                   image: block.settings.image,
                   ratio: 1,
                   sizes: '(min-width: 1024px) 16vw, (min-width: 768px) 25vw, 50vw',
                   widths: '200,300,400,600,800',
                   alt: block.settings.alt,
                   class: 'instagram__image' %}
              {%- endif -%}

              {%- if block.settings.link != blank -%}
                  <span class="visually-hidden">{{ block.settings.alt | default: 'View on Instagram' }}</span>
                </a>
              {%- endif -%}
              {%- endif -%}
            </li>

          {%- comment -%}
            An app block drops into a tile that is already the right size, so
            it cannot shift the page when it renders.
          {%- endcomment -%}
          {%- when '@app' -%}
            <li class="instagram__tile instagram__tile--app" {{ block.shopify_attributes }}>
              {% render block %}
            </li>
        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%}
        With nothing configured, the grid still occupies its final height.
        An empty section that later fills in is the shift we are avoiding.
      {%- endcomment -%}
      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..6) -%}
          <li class="instagram__tile instagram__tile--empty" aria-hidden="true"></li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Instagram",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the studio" },
    {
      "type": "select",
      "id": "reel_shape",
      "label": "Embed crop",
      "info": "Instagram's profile bar, caption and like row are cropped away either way. Use the full frame if a post is not a 9:16 reel.",
      "options": [
        { "value": "reel", "label": "Fill the tile (9:16)" },
        { "value": "full", "label": "Whole frame (4:5)" }
      ],
      "default": "reel"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "text", "id": "permalink", "label": "Instagram link", "info": "Paste the reel or post URL, e.g. https:\/\/www.instagram.com\/reel\/DbUm3CNPomR\/ — it is embedded live and takes priority over the image and reel below." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Reel", "info": "Upload a reel or clip. It plays muted on loop and replaces the image." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "alt", "label": "Alt text", "info": "Describe the image for screen readers." }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Instagram",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
