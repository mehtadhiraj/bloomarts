{{ 'component-image-text.css' | asset_url | stylesheet_tag }}
{%- if section.settings.art_source == 'illustration' -%}
  {{ 'component-studio-art.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- comment -%}
  Editorial image with text.

  Full bleed on purpose: no page-width wrapper and no block padding, so the
  image runs to the edges of the section on every side. The text sits over
  it in a higher stacking layer.

  The image carries no `ratio`, so the CDN serves it uncropped and the box
  crops it in CSS instead. That is the right way round here — this is a
  lifestyle image filling a band whose height changes with the viewport, so
  the crop has to be decided at render time, not at request time.

  The old per-element reveals are gone from this section. The sweep below is
  a single scroll-linked movement across the whole section; layering the
  generic reveals on top of it would mean two systems animating the same
  elements against each other.

  data-inline-svg: if the merchant picks an SVG, global.js swaps the <img> for
  the SVG markup itself. An SVG inside an <img> is a sealed document — CSS and
  JS in this page cannot reach a single shape inside it — so inlining is the
  only way its parts can be animated at all.

  No `parallax-media` either: once the band is pinned its image stops moving
  relative to the viewport, so a parallax drift keyed to the image's own
  view() timeline would freeze mid-drift exactly when the section is being
  looked at. The sweep is the effect here.

  No `defer-render` either, deliberately. `content-visibility: auto` guesses
  a height from `contain-intrinsic-size` (600px), which is wrong for a band
  that is a full viewport tall — the section rendered 600px while its own
  contents were 861px and the overflow was clipped. It also left the section's
  view() timeline inactive, so the sweep never ran at all. The section is one
  image and a paragraph; there is nothing here worth deferring.
{%- endcomment -%}

<section class="section image-text image-text--editorial">
  <div class="image-text__inner image-text__inner--{{ section.settings.layout }}">
    <div class="image-text__media" data-editorial="media" data-inline-svg>
      {%- if section.settings.art_source == 'illustration' -%}
        {%- comment -%}
          Rendered inline, not fetched. It is theme markup rather than an
          upload, so there is nothing to download, nothing to sanitise, and
          its colours come from the brand tokens.
        {%- endcomment -%}
        {% render 'studio-artwork', alt: section.settings.image_alt %}
      {%- else -%}
        {% render 'responsive-image',
           image: section.settings.image,
           sizes: '(min-width: 768px) 62vw, 100vw',
           widths: '600,800,1000,1200,1600,2000',
           alt: section.settings.image_alt,
           class: 'image-text__image' %}
      {%- endif -%}
    </div>

    <div class="image-text__content" data-editorial="text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow image-text__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="image-text__heading">
          <span class="image-text__heading-line">{{ section.settings.heading }}</span>
          {%- if section.settings.script_accent != blank -%}
            <span class="script image-text__script">{{ section.settings.script_accent }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte image-text__body">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.stat_value != blank -%}
        <p class="image-text__stat">
          <span class="image-text__stat-value">{{ section.settings.stat_value }}</span>
          {%- if section.settings.stat_label != blank -%}
            <span class="image-text__stat-label">{{ section.settings.stat_label }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--secondary image-text__button">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "select",
      "id": "art_source",
      "label": "Artwork",
      "info": "The illustration is drawn by the theme, so it follows the brand colours and animates part by part.",
      "options": [
        { "value": "image", "label": "Uploaded image" },
        { "value": "illustration", "label": "Bee illustration" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describes the image for screen readers. Leave blank if it is purely decorative."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "A short label above the heading.",
      "default": "The studio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made slowly,"
    },
    {
      "type": "text",
      "id": "script_accent",
      "label": "Heading accent",
      "info": "Set in the handwritten face, on its own line under the heading.",
      "default": "on purpose"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Concrete cures for seven days before it is sealed. Stoneware is fired twice. Resin is poured in layers over three. None of it can be rushed, which is why batches are small and why colour shifts a little between pieces.</p>"
    },
    {
      "type": "text",
      "id": "stat_value",
      "label": "Highlight",
      "info": "A short number or phrase set large beside the text. Leave empty to hide.",
      "default": "7 days"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Highlight label",
      "default": "for concrete to cure before it is sealed"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "About the studio"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position (desktop)",
      "info": "The entrance direction follows the image: it always arrives from its own side.",
      "options": [
        {
          "value": "text-first",
          "label": "Image right, text left"
        },
        {
          "value": "image-first",
          "label": "Image left, text right"
        }
      ],
      "default": "text-first"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
