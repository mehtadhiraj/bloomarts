{%- comment -%}
  Inline SVG icons.

  Inlined rather than sprited or icon-fonted: no extra request, no FOUT, no
  layout shift when the sprite arrives, and each icon inherits currentColor.
  All are aria-hidden — the accessible name belongs on the control, not the
  glyph.

  Accepts: icon {String}, size {Number} px (default 24), class {String}
{%- endcomment -%}

{%- liquid
  assign s = size | default: 24
  assign icon_class = class | default: ''
-%}

<svg
  class="icon icon--{{ icon }} {{ icon_class }}"
  width="{{ s }}"
  height="{{ s }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'menu' -%}
      <path d="M3 6h18M3 12h18M3 18h18"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    {%- when 'cart' -%}
      <path d="M3 5h2l2.2 11.2a1.5 1.5 0 0 0 1.5 1.2h8.1a1.5 1.5 0 0 0 1.5-1.2L20 8H6"/>
      <circle cx="9.5" cy="20" r="1.2" fill="currentColor" stroke="none"/>
      <circle cx="17.5" cy="20" r="1.2" fill="currentColor" stroke="none"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'chevron-right' -%}
      <path d="M9 5l7 7-7 7"/>
    {%- when 'chevron-left' -%}
      <path d="M15 5l-7 7 7 7"/>
    {%- when 'chevron-down' -%}
      <path d="M5 9l7 7 7-7"/>
    {%- when 'chevron-up' -%}
      <path d="M5 15l7-7 7 7"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h16M14 6l6 6-6 6"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'check' -%}
      <path d="M4 12.5l5 5L20 6.5"/>
    {%- when 'trash' -%}
      <path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"/>
    {%- when 'filter' -%}
      <path d="M3 6h18M6 12h12M10 18h4"/>
    {%- when 'upload' -%}
      <path d="M12 16V4M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/>
    {%- when 'file' -%}
      <path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7z"/><path d="M14 3v4h4"/>
    {%- when 'alert' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 16.5v.5"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1" fill="currentColor" stroke="none"/>
    {%- when 'facebook' -%}
      <path d="M14 8h2V5h-2a4 4 0 0 0-4 4v2H8v3h2v7h3v-7h2.5l.5-3H13V9a1 1 0 0 1 1-1z"/>
    {%- when 'pinterest' -%}
      <path d="M12 3a9 9 0 0 0-3.3 17.4c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.9 1.5 1.9 1.8 0 3.1-2.3 3.1-5 0-2.1-1.4-3.6-3.9-3.6a4.5 4.5 0 0 0-4.7 4.5c0 .9.3 1.5.8 2 .1.1.1.2.1.3l-.2.9c0 .2-.2.2-.4.1-1.1-.5-1.7-1.9-1.7-3.4 0-2.5 2.1-5.4 6.3-5.4 3.3 0 5.5 2.4 5.5 5 0 3.4-1.9 6-4.7 6-.9 0-1.8-.5-2.1-1.1l-.6 2.3c-.2.8-.7 1.6-1 2.2A9 9 0 1 0 12 3z" fill="currentColor" stroke="none"/>
  {%- endcase -%}
</svg>
