{%- comment -%}
  Filter and sort.

  One sheet, not two. Filtering and sorting are the same decision on a
  phone — "show me a different set" — and splitting them across two sheets
  doubles the taps for no gain. Sort sits first because it is the more
  common adjustment.

  The same markup becomes the desktop sidebar. It is rendered once and
  repositioned in CSS rather than duplicated, so there is only ever one copy
  of the filter list in the DOM and only one set of form controls to keep in
  sync.

  Accepts: collection {Object}, enable_filtering {Boolean}, enable_sorting {Boolean}
{%- endcomment -%}

{%- liquid
  assign active_count = 0
  if enable_filtering
    for filter in collection.filters
      assign active_count = active_count | plus: filter.active_values.size
      if filter.type == 'price_range'
        if filter.min_value.value != blank or filter.max_value.value != blank
          assign active_count = active_count | plus: 1
        endif
      endif
    endfor
  endif
-%}

<bloom-drawer id="facets-drawer" class="drawer drawer--tall facets" data-facets>
  <div class="drawer__overlay" data-drawer-overlay></div>

  <div
    class="drawer__panel facets__panel"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="facets-title"
    tabindex="-1"
  >
    <div class="drawer__handle" data-drawer-handle aria-hidden="true"></div>

    <div class="drawer__header facets__header">
      <h2 class="drawer__title" id="facets-title">
        {%- if enable_filtering and enable_sorting -%}
          {{ 'products.facets.filter_and_sort' | t }}
        {%- elsif enable_filtering -%}
          {{ 'products.facets.title' | t }}
        {%- else -%}
          {{ 'products.facets.sort_label' | t }}
        {%- endif -%}
      </h2>
      <button class="drawer__close tap-target" type="button" data-drawer-close data-drawer-initial-focus>
        {% render 'icon', icon: 'close' %}
        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
      </button>
    </div>

    {%- comment -%}
      A real GET form. Without JavaScript, Apply is a normal submit and
      filtering works exactly as it does with it.
    {%- endcomment -%}
    <form
      class="facets__form"
      method="get"
      action="{{ collection.url }}"
      data-facets-form
    >
      <div class="drawer__body facets__body">
        {%- comment -%} ---------- Sort ---------- {%- endcomment -%}
        {%- if enable_sorting -%}<details class="facets__group" open>
          <summary class="facets__summary">
            <span>{{ 'products.facets.sort_by' | t }}</span>
            {% render 'icon', icon: 'chevron-down', size: 20, class: 'facets__chevron' %}
          </summary>
          <fieldset class="facets__fieldset">
            <legend class="visually-hidden">{{ 'products.facets.sort_by' | t }}</legend>
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <div class="facets__row">
                <input
                  type="radio"
                  class="facets__control"
                  id="sort-{{ option.value }}"
                  name="sort_by"
                  value="{{ option.value }}"
                  {% if option.value == current_sort %}checked{% endif %}
                >
                <label class="facets__label" for="sort-{{ option.value }}">
                  <span class="facets__marker facets__marker--radio" aria-hidden="true"></span>
                  <span class="facets__text">{{ option.name }}</span>
                </label>
              </div>
            {%- endfor -%}
          </fieldset>
        </details>{%- endif -%}

        {%- comment -%} ---------- Filters ---------- {%- endcomment -%}
        {%- if enable_filtering -%}{%- for filter in collection.filters -%}
          <details class="facets__group" {% if filter.active_values.size > 0 %}open{% endif %}>
            <summary class="facets__summary">
              <span>
                {{ filter.label }}
                {%- if filter.active_values.size > 0 -%}
                  <span class="facets__count">({{ filter.active_values.size }})</span>
                {%- endif -%}
              </span>
              {% render 'icon', icon: 'chevron-down', size: 20, class: 'facets__chevron' %}
            </summary>

            {%- case filter.type -%}
              {%- when 'list' -%}
                <fieldset class="facets__fieldset">
                  <legend class="visually-hidden">{{ filter.label }}</legend>
                  {%- for value in filter.values -%}
                    <div class="facets__row">
                      <input
                        type="checkbox"
                        class="facets__control"
                        id="filter-{{ filter.param_name | handle }}-{{ forloop.index }}"
                        name="{{ filter.param_name }}"
                        value="{{ value.value }}"
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      >
                      <label
                        class="facets__label"
                        for="filter-{{ filter.param_name | handle }}-{{ forloop.index }}"
                      >
                        <span class="facets__marker" aria-hidden="true">
                          {% render 'icon', icon: 'check', size: 14 %}
                        </span>
                        <span class="facets__text">{{ value.label }}</span>
                        <span class="facets__count">{{ value.count }}</span>
                      </label>
                    </div>
                  {%- endfor -%}
                </fieldset>

              {%- when 'price_range' -%}
                <fieldset class="facets__fieldset facets__price">
                  <legend class="visually-hidden">{{ filter.label }}</legend>
                  <div class="facets__price-row">
                    <div class="field">
                      <label class="field__hint" for="{{ filter.min_value.param_name }}">
                        {{ 'products.facets.price_from' | t }}
                      </label>
                      <input
                        class="input"
                        type="number"
                        id="{{ filter.min_value.param_name }}"
                        name="{{ filter.min_value.param_name }}"
                        value="{{ filter.min_value.value }}"
                        min="0"
                        max="{{ filter.range_max | divided_by: 100 }}"
                        {%- comment -%} Decimal keypad, not the full keyboard. {%- endcomment -%}
                        inputmode="decimal"
                        placeholder="0"
                      >
                    </div>
                    <span class="facets__price-dash" aria-hidden="true">&ndash;</span>
                    <div class="field">
                      <label class="field__hint" for="{{ filter.max_value.param_name }}">
                        {{ 'products.facets.price_to' | t }}
                      </label>
                      <input
                        class="input"
                        type="number"
                        id="{{ filter.max_value.param_name }}"
                        name="{{ filter.max_value.param_name }}"
                        value="{{ filter.max_value.value }}"
                        min="0"
                        max="{{ filter.range_max | divided_by: 100 }}"
                        inputmode="decimal"
                        placeholder="{{ filter.range_max | divided_by: 100 }}"
                      >
                    </div>
                  </div>
                </fieldset>
            {%- endcase -%}
          </details>
        {%- endfor -%}{%- endif -%}
      </div>

      {%- comment -%}
        Apply is pinned to the bottom of the sheet — the easiest place to
        reach after scrolling a long filter list, and the last thing you do.
      {%- endcomment -%}
      <div class="drawer__footer facets__footer">
        {%- if enable_filtering -%}
          <a href="{{ collection.url }}" class="btn btn--secondary facets__clear">
            {{ 'products.facets.clear_all' | t }}
          </a>
        {%- endif -%}
        <button type="submit" class="btn btn--primary facets__apply">
          {{ 'products.facets.apply' | t }}
        </button>
      </div>
    </form>
  </div>
</bloom-drawer>
