{%- comment -%}
  Renders a <picture> with genuinely different mobile and desktop sources.

  Use this — not responsive-image — when the merchant can provide a separate
  mobile composition. Sources retain their natural proportions: the section
  controls their maximum display size without asking Shopify's CDN to crop.

  Accepts:
    image_desktop  {Object}  Wide crop (required)
    image_mobile   {Object}  Tall crop. Falls back to image_desktop.
    breakpoint     {String}  Where desktop takes over. Default '768px'.
    class, alt, loading, fetchpriority — as responsive-image.
{%- endcomment -%}

{%- liquid
  assign desktop_image = image_desktop
  assign mobile_image = image_mobile | default: image_desktop
  assign bp = breakpoint | default: '768px'
  assign img_loading = loading | default: 'lazy'
  assign img_priority = fetchpriority | default: 'auto'
  assign img_class = class | default: ''

  if alt != blank
    assign img_alt = alt
  else
    assign img_alt = desktop_image.alt
  endif

  assign mobile_widths = '360,414,480,640,828,1080' | split: ','
  assign desktop_widths = '768,1024,1280,1600,1920,2400' | split: ','
-%}

{%- if desktop_image != blank -%}
  {%- comment -%}
    Each srcset ends on the native width rather than relying on forloop.last,
    which would leave a trailing comma whenever a candidate is skipped for
    exceeding the source resolution.
  {%- endcomment -%}
  {%- capture desktop_srcset -%}
    {%- for w in desktop_widths -%}
      {%- assign cw = w | plus: 0 -%}
      {%- if cw < desktop_image.width -%}
        {{ desktop_image | image_url: width: cw }} {{ cw }}w,
      {%- endif -%}
    {%- endfor -%}
    {%- assign dw = desktop_image.width -%}
    {{ desktop_image | image_url: width: dw }} {{ dw }}w
  {%- endcapture -%}

  {%- capture mobile_srcset -%}
    {%- for w in mobile_widths -%}
      {%- assign cw = w | plus: 0 -%}
      {%- if cw < mobile_image.width -%}
        {{ mobile_image | image_url: width: cw }} {{ cw }}w,
      {%- endif -%}
    {%- endfor -%}
    {%- assign mw = mobile_image.width -%}
    {{ mobile_image | image_url: width: mw }} {{ mw }}w
  {%- endcapture -%}

  <picture>
    {%- comment -%} Desktop source first: <picture> takes the first match. {%- endcomment -%}
    <source media="(min-width: {{ bp }})" sizes="100vw" srcset="{{ desktop_srcset | strip }}">
    <source sizes="100vw" srcset="{{ mobile_srcset | strip }}">
    <img
      src="{{ mobile_image | image_url: width: 828 }}"
      alt="{{ img_alt | escape }}"
      width="{{ mobile_image.width }}"
      height="{{ mobile_image.height }}"
      loading="{{ img_loading }}"
      decoding="async"
      fetchpriority="{{ img_priority }}"
      class="{{ img_class }}"
    >
  </picture>
{%- endif -%}
