{%- comment -%}
  Quantity stepper.

  The stepper buttons exist because typing into a number field on a phone
  means summoning the keypad, clearing the value and retyping. They are the
  primary control; the field stays editable for large quantities and for
  keyboard users.

  Accepts:
    value     {Number}  Current quantity
    line_key  {String}  Cart line key — present in the cart, absent on a PDP
    label     {String}  Product title, for accessible names
    min       {Number}  Default 1. The cart passes 0 so a line can be emptied.
    name      {String}  Field name. Default 'quantity'.
    id_suffix {String}  Keeps ids unique when several appear on one page
{%- endcomment -%}

{%- liquid
  assign qty = value | default: 1
  assign qty_min = min | default: 1
  assign field_name = name | default: 'quantity'
  assign suffix = id_suffix | default: line_key | default: 'default'
  assign field_id = 'quantity-' | append: suffix
-%}

<quantity-input
  class="qty"
  {% if line_key != blank %}data-line-key="{{ line_key }}"{% endif %}
>
  <label class="visually-hidden" for="{{ field_id }}">
    {{ 'products.product.quantity' | t }}{% if label != blank %} &mdash; {{ label }}{% endif %}
  </label>

  <button
    type="button"
    class="qty__btn tap-target"
    data-qty-step="-1"
    aria-label="{{ 'products.product.decrease_quantity' | t }}"
  >
    {% render 'icon', icon: 'minus', size: 18 %}
  </button>

  <input
    id="{{ field_id }}"
    class="qty__input"
    type="number"
    name="{{ field_name }}"
    value="{{ qty }}"
    min="{{ qty_min }}"
    step="1"
    {%- comment -%} Numeric keypad, no spinner, no autocorrect. {%- endcomment -%}
    inputmode="numeric"
    pattern="[0-9]*"
    autocomplete="off"
    data-qty-input
  >

  <button
    type="button"
    class="qty__btn tap-target"
    data-qty-step="1"
    aria-label="{{ 'products.product.increase_quantity' | t }}"
  >
    {% render 'icon', icon: 'plus', size: 18 %}
  </button>
</quantity-input>
