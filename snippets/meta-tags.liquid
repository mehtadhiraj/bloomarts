{%- comment -%}
  Search and social metadata. Native Shopify SEO fields always win; theme
  settings are fallbacks for a new store or an unconfigured page.
{%- endcomment -%}

{%- liquid
  assign seo_title = page_title
  if template.name == 'index'
    if seo_title == blank or seo_title == shop.name
      assign seo_title = settings.seo_home_title | default: shop.name
    endif
  endif

  assign seo_description = page_description | strip_html | strip
  if seo_description == blank
    case request.page_type
      when 'product'
        assign seo_description = product.description | strip_html | strip
      when 'collection'
        assign seo_description = collection.description | strip_html | strip
      when 'article'
        assign seo_description = article.excerpt_or_content | strip_html | strip
      when 'page'
        assign seo_description = page.content | strip_html | strip
    endcase
  endif
  if seo_description == blank
    assign seo_description = settings.seo_default_description | default: shop.description | strip_html | strip
  endif
  assign seo_description = seo_description | truncate: 160

  assign seo_image = blank
  if request.page_type == 'product' and product.featured_image != blank
    assign seo_image = product.featured_image
  elsif request.page_type == 'collection' and collection.image != blank
    assign seo_image = collection.image
  elsif request.page_type == 'article' and article.image != blank
    assign seo_image = article.image
  elsif settings.share_image != blank
    assign seo_image = settings.share_image
  endif

  assign seo_noindex = false
  if template.name == 'search' or template.name == 'cart' or template.name == '404'
    assign seo_noindex = true
  endif
  if request.page_type contains 'customers'
    assign seo_noindex = true
  endif
-%}

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; {{ 'general.search.results_for' | t: terms: current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
  {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

{%- if seo_description != blank -%}
  <meta name="description" content="{{ seo_description | escape }}">
{%- endif -%}

{%- if seo_noindex -%}
  <meta name="robots" content="noindex,follow">
{%- else -%}
  <meta name="robots" content="index,follow,max-image-preview:large">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
<meta property="og:description" content="{{ seo_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if seo_image != blank -%}
  {%- assign social_image_url = seo_image | image_url: width: 1200 -%}
  {%- unless social_image_url contains '://' -%}
    {%- if social_image_url contains '//' -%}
      {%- assign social_image_url = social_image_url | prepend: 'https:' -%}
    {%- else -%}
      {%- assign social_image_url = social_image_url | prepend: shop.url -%}
    {%- endif -%}
  {%- endunless -%}
  <meta property="og:image" content="{{ social_image_url }}">
  <meta property="og:image:secure_url" content="{{ social_image_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: seo_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ seo_image.alt | default: seo_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign seo_variant = product.selected_or_first_available_variant -%}
  <meta property="product:price:amount" content="{{ seo_variant.price | money_without_currency | replace: ',', '' | strip }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
  <meta property="product:availability" content="{% if seo_variant.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

<meta name="twitter:card" content="{% if seo_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_description | escape }}">
{%- if seo_image != blank -%}
  <meta name="twitter:image" content="{{ social_image_url }}">
  <meta name="twitter:image:alt" content="{{ seo_image.alt | default: seo_title | escape }}">
{%- endif -%}
