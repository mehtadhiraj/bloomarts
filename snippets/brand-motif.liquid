{%- comment -%}
  Decorative brand motifs drawn from the Bloom Arts identity — the bee, the
  brushed heart and the leaf sprigs.

  These are page furniture, never content. Each is aria-hidden and none
  carries information, so a screen reader passes straight over them and
  turning them off removes nothing a customer needs.

  Accepts:
    motif  {String}  'bee' | 'heart' | 'sprig' | 'sprig-pair' | 'blob'
    size   {Number}  px, default 64
    class  {String}
    style  {String}  Inline positioning, e.g. 'top: 4%; right: 6%;'
{%- endcomment -%}

{%- liquid
  assign s = size | default: 64
  assign motif_class = class | default: ''
-%}

<span
  class="motif {{ motif_class }}"
  style="width: {{ s }}px; height: {{ s }}px; {{ style }}"
  aria-hidden="true"
>
  {%- case motif -%}
    {%- when 'bee' -%}
      <svg viewBox="0 0 64 64" fill="none" width="{{ s }}" height="{{ s }}" focusable="false">
        <path d="M20 22c-5-7-1-13 4-11 3 1 5 4 6 7" stroke="var(--brand-brown)" stroke-width="2.2" stroke-linecap="round"/>
        <path d="M44 22c5-7 1-13-4-11-3 1-5 4-6 7" stroke="var(--brand-brown)" stroke-width="2.2" stroke-linecap="round"/>
        <ellipse cx="32" cy="38" rx="14" ry="16" fill="var(--brand-amber)"/>
        <path d="M19 32h26M20 40h24M23 48h18" stroke="var(--brand-brown)" stroke-width="3.4" stroke-linecap="round"/>
        <circle cx="26" cy="28" r="1.6" fill="var(--brand-brown)"/>
        <circle cx="38" cy="28" r="1.6" fill="var(--brand-brown)"/>
      </svg>

    {%- when 'heart' -%}
      <svg viewBox="0 0 64 64" fill="none" width="{{ s }}" height="{{ s }}" focusable="false">
        <path
          d="M32 54S9 40 9 24C9 15 16 9 23 9c4 0 8 2 9 6 1-4 5-6 9-6 7 0 14 6 14 15 0 16-23 30-23 30z"
          fill="var(--brand-coral)"
        />
      </svg>

    {%- when 'heart-outline' -%}
      <svg viewBox="0 0 64 64" fill="none" width="{{ s }}" height="{{ s }}" focusable="false">
        <path
          d="M32 54S9 40 9 24C9 15 16 9 23 9c4 0 8 2 9 6 1-4 5-6 9-6 7 0 14 6 14 15 0 16-23 30-23 30z"
          stroke="var(--brand-coral)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"
        />
      </svg>

    {%- when 'sprig' -%}
      <svg viewBox="0 0 64 64" fill="none" width="{{ s }}" height="{{ s }}" focusable="false">
        <path d="M10 54C22 46 38 32 54 12" stroke="var(--brand-olive)" stroke-width="2.4" stroke-linecap="round"/>
        <ellipse cx="24" cy="40" rx="8" ry="4.6" transform="rotate(-38 24 40)" fill="var(--brand-sage)"/>
        <ellipse cx="35" cy="30" rx="8" ry="4.6" transform="rotate(-38 35 30)" fill="var(--brand-olive)"/>
        <ellipse cx="45" cy="20" rx="7" ry="4.2" transform="rotate(-38 45 20)" fill="var(--brand-sage)"/>
        <ellipse cx="17" cy="33" rx="7" ry="4.2" transform="rotate(28 17 33)" fill="var(--brand-olive)"/>
        <ellipse cx="28" cy="23" rx="6.4" ry="4" transform="rotate(28 28 23)" fill="var(--brand-sage)"/>
      </svg>

    {%- when 'sprig-pair' -%}
      <svg viewBox="0 0 128 64" fill="none" width="{{ s }}" height="{{ s }}" focusable="false">
        <path d="M4 32c14 0 26-6 34-14" stroke="var(--brand-olive)" stroke-width="2.2" stroke-linecap="round"/>
        <ellipse cx="16" cy="27" rx="7" ry="4" transform="rotate(-24 16 27)" fill="var(--brand-sage)"/>
        <ellipse cx="29" cy="23" rx="7" ry="4" transform="rotate(-24 29 23)" fill="var(--brand-olive)"/>
        <path d="M124 32c-14 0-26-6-34-14" stroke="var(--brand-olive)" stroke-width="2.2" stroke-linecap="round"/>
        <ellipse cx="112" cy="27" rx="7" ry="4" transform="rotate(24 112 27)" fill="var(--brand-sage)"/>
        <ellipse cx="99" cy="23" rx="7" ry="4" transform="rotate(24 99 23)" fill="var(--brand-olive)"/>
        <path d="M64 44s-8-5-8-11c0-3 2-5 5-5 1.5 0 2.7.7 3 1.8.3-1.1 1.5-1.8 3-1.8 3 0 5 2 5 5 0 6-8 11-8 11z" fill="var(--brand-coral)"/>
      </svg>

    {%- comment -%}
      An organic colour blob, matching the curved corner shapes on the brand
      sheet's social banner.
    {%- endcomment -%}
    {%- when 'blob' -%}
      <svg viewBox="0 0 200 200" fill="none" width="{{ s }}" height="{{ s }}" focusable="false">
        <path
          d="M43 -66C58 -55 71 -42 79 -25c8 17 11 38 3 53-8 16-27 25-46 32-19 7-38 12-55 8-17-4-32-17-42-34-10-17-15-38-9-55 6-17 23-30 42-38 19-8 40-11 57-6 17 5 30 18 43 29z"
          transform="translate(100 100)"
          fill="currentColor"
        />
      </svg>
  {%- endcase -%}
</span>
