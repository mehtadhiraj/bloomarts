{%- comment -%}
  Search sheet.

  Full-height on mobile rather than a dropdown under the header. Once the
  virtual keyboard is up, a dropdown has roughly two visible rows left; a
  sheet keeps the field pinned to the top of the remaining space and gives
  the results the rest of it. The viewport meta sets
  interactive-widget=resizes-content, so the keyboard shrinks the sheet
  instead of covering it.
{%- endcomment -%}

<bloom-drawer id="search-drawer" class="drawer drawer--search drawer--tall">
  <div class="drawer__overlay" data-drawer-overlay></div>

  <div
    class="drawer__panel"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-drawer-title"
    tabindex="-1"
  >
    <div class="drawer__handle" data-drawer-handle aria-hidden="true"></div>

    <div class="drawer__header">
      <h2 class="drawer__title" id="search-drawer-title">{{ 'general.search.title' | t }}</h2>
      <button class="drawer__close tap-target" type="button" data-drawer-close>
        {% render 'icon', icon: 'close' %}
        <span class="visually-hidden">{{ 'general.accessibility.close' | t }}</span>
      </button>
    </div>

    <predictive-search class="search" data-search>
      {%- comment -%}
        A real GET form to /search. Submitting works with JavaScript
        disabled or still loading; the predictive layer only decorates it.
      {%- endcomment -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
        <input type="hidden" name="options[prefix]" value="last">

        <div class="search__field">
          <label for="search-input" class="visually-hidden">{{ 'general.search.title' | t }}</label>
          {% render 'icon', icon: 'search', size: 20, class: 'search__icon' %}
          <input
            id="search-input"
            class="search__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            enterkeyhint="search"
            data-drawer-initial-focus
            data-search-input
            role="combobox"
            aria-expanded="false"
            aria-owns="search-results"
            aria-controls="search-results"
            aria-autocomplete="list"
          >
          <button
            type="button"
            class="search__clear tap-target"
            data-search-clear
            hidden
          >
            {% render 'icon', icon: 'close', size: 18 %}
            <span class="visually-hidden">{{ 'general.search.clear' | t }}</span>
          </button>
        </div>

        <button type="submit" class="btn btn--primary search__submit">
          {{ 'general.search.submit' | t }}
        </button>
      </form>

      <div
        id="search-results"
        class="search__results"
        data-search-results
        role="listbox"
        tabindex="-1"
      ></div>
    </predictive-search>
  </div>
</bloom-drawer>
