{%- comment -%}
  Pagination. Accepts: paginate {Object}
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination__list" role="list">
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}" class="pagination__link tap-target" rel="prev">
            {% render 'icon', icon: 'chevron-left', size: 18 %}
            <span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span>
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="pagination__link tap-target">
              <span class="visually-hidden">{{ 'general.pagination.page' | t: number: part.title }}</span>
              <span aria-hidden="true">{{ part.title }}</span>
            </a>
          {%- else -%}
            <span class="pagination__link pagination__link--current tap-target" aria-current="page">
              <span class="visually-hidden">{{ 'general.pagination.page' | t: number: part.title }}</span>
              <span aria-hidden="true">{{ part.title }}</span>
            </span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}" class="pagination__link tap-target" rel="next">
            {% render 'icon', icon: 'chevron-right', size: 18 %}
            <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
