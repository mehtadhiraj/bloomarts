{%- comment -%}
  JSON-LD for search engines. Only storefront facts available from Shopify
  are emitted; ratings, returns and shipping are deliberately omitted until
  the corresponding verified data exists in the store.
{%- endcomment -%}

{%- if template.name == 'index' -%}
  {%- assign organization_id = shop.url | append: '/#organization' -%}
  {%- assign website_id = shop.url | append: '/#website' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ organization_id | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }},
          "description": {{ settings.seo_default_description | default: shop.description | strip_html | strip | json }}{% if settings.logo != blank %},
          {%- assign organization_logo_url = settings.logo | image_url: width: 512 -%}
          {%- unless organization_logo_url contains '://' -%}
            {%- if organization_logo_url contains '//' -%}
              {%- assign organization_logo_url = organization_logo_url | prepend: 'https:' -%}
            {%- else -%}
              {%- assign organization_logo_url = organization_logo_url | prepend: shop.url -%}
            {%- endif -%}
          {%- endunless -%}
          "logo": {{ organization_logo_url | json }}{% endif %},
          "sameAs": [
            {%- assign has_social_link = false -%}
            {%- if settings.social_instagram != blank -%}
              {{ settings.social_instagram | json }}
              {%- assign has_social_link = true -%}
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              {%- if has_social_link -%},{%- endif -%}{{ settings.social_facebook | json }}
              {%- assign has_social_link = true -%}
            {%- endif -%}
            {%- if settings.social_pinterest != blank -%}
              {%- if has_social_link -%},{%- endif -%}{{ settings.social_pinterest | json }}
            {%- endif -%}
          ]
        },
        {
          "@type": "WebSite",
          "@id": {{ website_id | json }},
          "url": {{ shop.url | json }},
          "name": {{ shop.name | json }},
          "description": {{ settings.seo_default_description | default: shop.description | strip_html | strip | json }},
          "publisher": { "@id": {{ organization_id | json }} },
          "inLanguage": {{ request.locale.iso_code | json }}
        }
      ]
    }
  </script>
{%- endif -%}

{%- if template.name == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ canonical_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ canonical_url | json }},
      "description": {{ product.description | strip_html | strip | json }},
      "image": [
        {%- for image in product.images limit: 10 -%}
          {%- assign product_image_url = image | image_url: width: 1200 -%}
          {%- unless product_image_url contains '://' -%}
            {%- if product_image_url contains '//' -%}
              {%- assign product_image_url = product_image_url | prepend: 'https:' -%}
            {%- else -%}
              {%- assign product_image_url = product_image_url | prepend: shop.url -%}
            {%- endif -%}
          {%- endunless -%}
          {{ product_image_url | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]{% if product.type != blank %},
      "category": {{ product.type | json }}{% endif %},
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | default: shop.name | json }}
      },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "url": {{ shop.url | append: product.url | append: '?variant=' | append: variant.id | json }},
            "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition"{% if variant.sku != blank %},
            "sku": {{ variant.sku | json }}{% endif %}{% if variant.barcode != blank %},
            "gtin": {{ variant.barcode | json }}{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- unless template.name == 'index' or template.name == 'search' or template.name == 'cart' or template.name == '404' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ page_title | json }},
          "item": {{ canonical_url | json }}
        }
      ]
    }
  </script>
{%- endunless -%}
