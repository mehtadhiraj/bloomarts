{%- comment -%}
  A single cart line, shared by the drawer and the cart page.

  Customization properties are rendered in full, never truncated away on
  small screens. What someone typed as an engraving or uploaded as a
  reference is the reason they are buying — hiding it to tidy the mobile
  layout would remove the one detail they most need to verify before paying.

  Accepts: item {Object} line item, compact {Boolean}
{%- endcomment -%}

<li class="cart-item{% if compact %} cart-item--compact{% endif %}" data-cart-item data-line-key="{{ item.key }}">
  <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
    {% render 'responsive-image',
       image: item.image,
       ratio: 1,
       sizes: '80px',
       widths: '80,120,160,240',
       class: 'cart-item__image' %}
  </a>

  <div class="cart-item__details">
    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>

    {%- comment -%} Variant options, e.g. Size / Finish. {%- endcomment -%}
    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__variant text-sm text-muted">
        {%- for option in item.options_with_values -%}
          {{ option.name }}: {{ option.value }}{% unless forloop.last %} &middot; {% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    {%- comment -%}
      Line item properties. Shopify prefixes internal properties with an
      underscore; those are implementation detail and stay hidden.
    {%- endcomment -%}
    {%- assign has_properties = false -%}
    {%- for property in item.properties -%}
      {%- assign property_prefix = property.first | slice: 0 -%}
      {%- unless property.first == blank or property.last == blank or property_prefix == '_' -%}
        {%- assign has_properties = true -%}
      {%- endunless -%}
    {%- endfor -%}

    {%- if has_properties -%}
      <dl class="cart-item__properties">
        {%- for property in item.properties -%}
          {%- assign property_prefix = property.first | slice: 0 -%}
          {%- if property.first == blank or property.last == blank or property_prefix == '_' -%}
            {%- continue -%}
          {%- endif -%}
          <dt>{{ property.first }}</dt>
          <dd>
            {%- comment -%}
              An uploaded file arrives as a URL. Link it so the customer can
              confirm they sent the right artwork.
            {%- endcomment -%}
            {%- if property.last contains '/uploads/' -%}
              <a href="{{ property.last }}" target="_blank" rel="noopener">
                {{ property.last | split: '/' | last }}
              </a>
            {%- else -%}
              {{ property.last }}
            {%- endif -%}
          </dd>
        {%- endfor -%}
      </dl>
    {%- endif -%}

    {%- if item.selling_plan_allocation -%}
      <p class="cart-item__variant text-sm text-muted">{{ item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}

    <div class="cart-item__controls">
      {% render 'quantity-input',
         value: item.quantity,
         line_key: item.key,
         label: item.product.title,
         min: 0 %}

      <div class="cart-item__price">
        {%- if item.original_line_price > item.final_line_price -%}
          <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
          <span class="price price--on-sale">
            <span class="price__current">{{ item.final_line_price | money }}</span>
            <s class="price__compare">{{ item.original_line_price | money }}</s>
          </span>
        {%- else -%}
          <span class="price"><span class="price__current">{{ item.final_line_price | money }}</span></span>
        {%- endif -%}
      </div>
    </div>

    {%- if item.line_level_discount_allocations.size > 0 -%}
      <ul class="cart-item__discounts" role="list">
        {%- for discount in item.line_level_discount_allocations -%}
          <li class="text-sm">{{ discount.discount_application.title }} (&minus;{{ discount.amount | money }})</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if item.error_message -%}
      <p class="field__error text-sm" role="alert">
        {% render 'icon', icon: 'alert', size: 16 %}
        {{ item.error_message }}
      </p>
    {%- endif -%}
  </div>

  {%- comment -%}
    Remove is a separate control from "quantity down to zero" — hunting a
    minus button to zero is a poor way to delete something on a phone.
  {%- endcomment -%}
  <button
    type="button"
    class="cart-item__remove tap-target"
    data-cart-remove
    data-line-key="{{ item.key }}"
  >
    {% render 'icon', icon: 'trash', size: 18 %}
    <span class="visually-hidden">{{ 'cart.general.remove' | t: title: item.product.title }}</span>
  </button>
</li>
