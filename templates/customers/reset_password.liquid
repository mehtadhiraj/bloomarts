{{ 'component-customer.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Reached from the link in Shopify's reset email. Shopify validates the token
  in the URL and sets the new password; the theme only collects it.
{%- endcomment -%}

<div class="customer page-width page-width--narrow">
  <h1 class="customer__title">{{ 'customer.login.recover_title' | t }}</h1>

  <div class="customer__panel">
    {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
      {% render 'form-errors', form: form %}

      <div class="field">
        <label class="field__label" for="reset-password">{{ 'customer.register.password' | t }}</label>
        <input type="password" class="input" id="reset-password" name="customer[password]"
               autocomplete="new-password" enterkeyhint="next" required>
      </div>

      <div class="field">
        <label class="field__label" for="reset-confirm">{{ 'customer.activate.confirm' | t }}</label>
        <input type="password" class="input" id="reset-confirm" name="customer[password_confirmation]"
               autocomplete="new-password" enterkeyhint="go" required>
      </div>

      <button type="submit" class="btn btn--primary customer__submit">
        {{ 'customer.login.recover_submit' | t }}
      </button>
    {%- endform -%}
  </div>
</div>
