{%- comment -%}
  Password page.

  Required whenever the storefront password is enabled. Without it Shopify has
  no template for /password, which is exactly the state this store was in.

  Deliberately standalone: it does not use the theme layout, because the
  header, cart and navigation are all meaningless behind a password gate.
{%- endcomment -%}

{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --color-background: {{ settings.color_cream }};
        --color-text: {{ settings.color_brown }};
        --color-accent: {{ settings.color_amber }};
        --color-accent-contrast: {{ settings.color_brown }};
        --brand-brown: {{ settings.color_brown }};
        --brand-amber: {{ settings.color_amber }};
        --brand-sage: {{ settings.color_sage }};
        --brand-cream: {{ settings.color_cream }};
        --radius-button: 999px;
      }

      .password {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-md);
        padding: var(--space-lg) calc(var(--gutter) + var(--safe-left));
        text-align: center;
      }

      .password__logo { max-width: 220px; height: auto; }

      .password__title {
        font-size: var(--text-2xl);
        margin: 0;
      }

      .password__form {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
        width: 100%;
        max-width: 340px;
      }

      @media (min-width: 480px) {
        .password__form { flex-direction: row; }
        .password__form .field { flex: 1 1 auto; }
      }
    </style>
  </head>

  <body class="password-page">
    <main class="password">
      {%- if settings.logo != blank -%}
        <img
          class="password__logo"
          src="{{ settings.logo | image_url: width: 440 }}"
          alt="{{ shop.name | escape }}"
          width="220"
          height="{{ 220 | divided_by: settings.logo.aspect_ratio | round }}"
        >
      {%- else -%}
        <h1 class="password__title">{{ shop.name }}</h1>
      {%- endif -%}

      {%- if settings.tagline != blank -%}
        <p class="text-muted">{{ settings.tagline }}</p>
      {%- endif -%}

      {%- form 'storefront_password', class: 'password__form' -%}
        <div class="field">
          <label class="visually-hidden" for="password">{{ 'general.password.label' | t }}</label>
          <input
            class="input"
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            placeholder="{{ 'general.password.placeholder' | t }}"
            required
          >
        </div>
        <button type="submit" class="btn btn--primary">{{ 'general.password.submit' | t }}</button>

        {%- if form.errors -%}
          <p class="field__error" role="alert">{{ 'general.password.error' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </main>
  </body>
</html>
